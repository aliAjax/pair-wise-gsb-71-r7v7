{
  "name": "pair-wise-gsb-71",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "verify": "esbuild scripts/run-verify.ts --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs --alias:@=./src && node scripts/.verify.mjs",
    "verify:http": "esbuild scripts/run-http.ts --bundle --platform=node --format=cjs --outfile=scripts/.verify-http.cjs --alias:@=./src && node scripts/.verify-http.cjs",
    "verify:all": "npm run verify && npm run verify:http"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tanstack/vue-query": "^5.66.0",
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
